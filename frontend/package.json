{
  "name": "xkeen-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "test:visual": "playwright test --project=visual",
    "test:behavior": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:integration": "playwright test --project=integration",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && rspack build && node scripts/manifest.mjs",
    "dev": "rspack serve",
    "test": "npm run test:build && rstest run --passWithNoTests",
    "test:build": "node scripts/check-build.mjs",
    "test:unit": "rstest run",
    "test:protocol": "playwright test --config playwright.protocol.config.ts",
    "test:protocol:serve": "rspack serve --config rspack.protocol.config.mjs",
    "build-storybook": "storybook build --disable-telemetry",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "test:components": "playwright test --config playwright.components.config.ts",
    "test:components:serve": "rspack serve --config rspack.components.config.mjs",
    "test:native-browser-lifecycle": "node --test tests/support/native-browsers.test.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@rspack/core": "2.3.3",
    "@rspack/cli": "2.3.3",
    "@rspack/dev-server": "2.2.2",
    "@rstest/core": "0.12.6",
    "storybook": "10.6.7",
    "storybook-react-rsbuild": "3.6.3",
    "@rsbuild/core": "2.3.3",
    "@rsbuild/plugin-react": "2.1.1",
    "@types/node": "24.19.2",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.11.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@tanstack/react-query": "5.108.0"
  }
}
