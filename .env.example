# Copy to .env and keep it private: cp .env.example .env && chmod 600 .env
# Values are read literally by Docker Compose; do not quote them.

# Router address and SSH (Entware/Dropbear) credentials. Required.
ROUTER_HOST=192.168.1.1
ROUTER_USER=root
ROUTER_PORT=22
SSH_PASSWORD=

# VPN provider subscription URL (base64 list of vless:// links or an Xray JSON array).
# Optional here: you can also enter it in the web UI.
SUB_URL=

# Optional: Keenetic web-interface account for the Devices panel (HTTP RCI).
# Leave empty to hide device management; everything else keeps working.
KEENETIC_URL=
KEENETIC_USER=
KEENETIC_PASSWORD=

# Optional: Keenetic connection policies routed through XKeen, e.g.
# policy:Policy0,policy:Policy2 or default. Can also be chosen in Devices → Routing setup.
XK_DEVICE_POLICY_IDS=
